load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "model",
    srcs = [
        "building.cpp",
        "yaml_io.cpp",
    ],
    hdrs = [
        "building.hpp",
        "yaml_io.hpp",
    ],
    strip_include_prefix = "/",
    deps = [
        "@yaml-cpp",
    ],
)

cc_test(
    name = "yaml_io_test",
    srcs = ["yaml_io_test.cpp"],
    deps = [":model"],
)
