load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "model",
    srcs = [
        "building.cpp",
        "yaml_io.cpp",
    ],
    hdrs = [
        "building.hpp",
        "yaml_io.hpp",
    ],
    strip_include_prefix = "/",
    deps = [
        "@yaml-cpp",
    ],
)

cc_test(
    name = "yaml_io_test",
    srcs = ["yaml_io_test.cpp"],
    deps = [":model"],
)

# No zip and no UI, so path handling costs the editor nothing extra.
cc_library(
    name = "asset_paths",
    srcs = ["asset_paths.cpp"],
    hdrs = ["asset_paths.hpp"],
    strip_include_prefix = "/",
    deps = [":model"],
)

cc_library(
    name = "map_bundle",
    srcs = ["map_bundle.cpp"],
    hdrs = ["map_bundle.hpp"],
    strip_include_prefix = "/",
    deps = [
        ":asset_paths",
        ":model",
        "//third_party/miniz",
        "@nlohmann_json//:json",
    ],
)

cc_test(
    name = "map_bundle_test",
    srcs = ["map_bundle_test.cpp"],
    deps = [
        ":map_bundle",
        "//third_party/miniz",
    ],
)
