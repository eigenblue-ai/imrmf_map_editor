load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "view",
    srcs = [
        "canvas_controls.cpp",
        "editor_view.cpp",
    ],
    hdrs = [
        "canvas_controls.hpp",
        "editor_view.hpp",
    ],
    deps = [
        "//canvas",
        "//canvas:http_texture_provider",
        "//model",
        "//model:asset_paths",
        "//ui:icons",
        "//ui:notifications",
        "//ui:widgets",
        "@imgui_docking//:imgui",
        "@imgui_docking//:imgui_stdlib",
    ] + select({
        # Undo/redo goes through the desktop CRDT client, the browser uses JS.
        "//config:wasm": [],
        "//conditions:default": ["//client_rust:client_ffi"],
    }),
)
