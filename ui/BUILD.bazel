load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

# Headers are exposed under the ui/ prefix, so `#include "ui/theme.hpp"` works
# from anywhere in the repo.

# Brand palette + ImGui style. ImGui only.
cc_library(
    name = "theme",
    hdrs = ["theme.hpp"],
    strip_include_prefix = "/",
    deps = ["@imgui_docking//:imgui"],
)

# Form-table layout helpers + segmented control. ImGui only.
cc_library(
    name = "widgets",
    hdrs = ["widgets.hpp"],
    strip_include_prefix = "/",
    deps = [
        ":theme",
        "@imgui_docking//:imgui",
    ],
)

# Bundled Inter font + a loader. Add :fonts to your binary's data.
cc_library(
    name = "font",
    hdrs = ["font.hpp"],
    data = [":fonts"],
    strip_include_prefix = "/",
    deps = ["@imgui_docking//:imgui"],
)

# The ImGui-only core in one dep.
cc_library(
    name = "core",
    deps = [
        ":font",
        ":theme",
        ":widgets",
    ],
)

# Fullscreen dockspace host boilerplate for docked tools.
cc_library(
    name = "dockspace",
    hdrs = ["dockspace.hpp"],
    strip_include_prefix = "/",
    deps = ["@imgui_docking//:imgui"],
)

# Tool-window registry with a visibility menu and name=0|1 persistence.
cc_library(
    name = "window_manager",
    hdrs = ["window_manager.hpp"],
    strip_include_prefix = "/",
    deps = ["@imgui_docking//:imgui"],
)

# Pan/zoom transform for a 2D world-space canvas. ImGui only.
cc_library(
    name = "viewport",
    hdrs = ["viewport.hpp"],
    strip_include_prefix = "/",
    deps = ["@imgui_docking//:imgui"],
)

# Byte-size / duration / timestamp / id formatters. No ImGui.
cc_library(
    name = "format",
    hdrs = ["format.hpp"],
    strip_include_prefix = "/",
)

# Opt-in: schema-driven form UI. Pulls in nlohmann_json, so it is kept out of
# the core for consumers that do not want the JSON dependency.
cc_library(
    name = "schema_ui",
    srcs = ["schema_ui.cpp"],
    hdrs = ["schema_ui.hpp"],
    strip_include_prefix = "/",
    deps = [
        ":widgets",
        "@imgui_docking//:imgui",
        "@nlohmann_json//:json",
    ],
)

# Edge flood-fill to knock out a white background. No ImGui, no other deps.
cc_library(
    name = "image_utils",
    hdrs = ["image_utils.hpp"],
    strip_include_prefix = "/",
)

# Vendored stb_image / stb_image_write.
cc_library(
    name = "stb_image",
    srcs = ["stb_image_impl.cpp"],
    hdrs = [
        "stb_image.h",
        "stb_image_write.h",
    ],
    strip_include_prefix = "/",
)

filegroup(
    name = "fonts",
    srcs = [
        "fonts/Inter.ttf",
        "fonts/OFL.txt",
    ],
)

# Just the .ttf, for a single-file reference like an emscripten --preload-file.
filegroup(
    name = "font_ttf",
    srcs = ["fonts/Inter.ttf"],
)

# Material Design Icons (Apache-2.0) as an icon font. ICON_MDI_* macros + a
# merge-load helper. Needs ImGui built with IMGUI_USE_WCHAR32 (MDI codepoints
# are above U+FFFF).
cc_library(
    name = "icons",
    hdrs = [
        "IconsMaterialDesignIcons.h",
        "icons.hpp",
    ],
    data = [":font_mdi"],
    strip_include_prefix = "/",
    deps = ["@imgui_docking//:imgui"],
)

filegroup(
    name = "font_mdi",
    srcs = ["fonts/materialdesignicons-webfont.ttf"],
)
