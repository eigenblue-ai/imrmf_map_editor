load("@emsdk//emscripten_toolchain:wasm_rules.bzl", "wasm_cc_binary")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")

package(default_visibility = ["//visibility:public"])

_APP_DEPS = [
    "//canvas:http_texture_provider",
    "//canvas:stb_texture_provider",
    "//model",
    "//model:asset_paths",
    "//model:map_bundle",
    "//ui:core",
    "//ui:icons",
    "//view",
    "@imgui_docking//:imgui",
    "@imgui_docking//:platform-glfw",
    "@imgui_docking//:renderer-opengl3",
] + select({
    # The browser gets the picker, REST, and Yjs from JS.
    "//config:wasm": [],
    "//conditions:default": [
        ":platform",
        "//client_rust:client_ffi",
    ],
})

# OS file picker and window chrome. Platforms without them fall back to the
# in-app browser and the system title bar.
cc_library(
    name = "platform",
    deps = [":platform_hdrs"] + select({
        "@platforms//os:macos": [":platform_mac"],
        "//conditions:default": [":platform_stub"],
    }),
)

cc_library(
    name = "platform_hdrs",
    hdrs = [
        "file_dialog.hpp",
        "window_chrome.hpp",
    ],
    strip_include_prefix = "/",
)

# NSOpenPanel and NSWindow, so objc++ rather than cc_library.
objc_library(
    name = "platform_mac",
    srcs = [
        "file_dialog_mac.mm",
        "window_chrome_mac.mm",
    ],
    linkopts = ["-framework AppKit"],
    deps = [
        ":platform_hdrs",
        "@glfw",
    ],
)

cc_library(
    name = "platform_stub",
    srcs = [
        "file_dialog_other.cpp",
        "window_chrome_other.cpp",
    ],
    deps = [":platform_hdrs"],
)

cc_binary(
    name = "editor_wasm_target",
    srcs = ["main.cpp"],
    additional_linker_inputs = select({
        "//config:wasm": [
            "shell_minimal.html",
            "//ui:font_ttf",
            "//ui:font_mdi",
        ],
        "//conditions:default": [],
    }),
    copts = select({
        "//config:wasm": ["-DImDrawIdx=unsigned"],
        "//conditions:default": [],
    }),
    data = select({
        "//config:wasm": ["shell_minimal.html"],
        "//conditions:default": [],
    }),
    linkopts = select({
        "//config:wasm": [
            "--oformat=html",
            "--shell-file=$(location shell_minimal.html)",
            "-sUSE_GLFW=3",
            "-sUSE_WEBGL2=1",
            "-sFULL_ES3=1",
            "-sALLOW_MEMORY_GROWTH=1",
            "-sFETCH=1",
            "-sFORCE_FILESYSTEM=1",
            "--preload-file=$(location //ui:font_ttf)@Inter.ttf",
            "--preload-file=$(location //ui:font_mdi)@materialdesignicons-webfont.ttf",
            "-sEXPORTED_RUNTIME_METHODS=UTF8ToString,stringToNewUTF8,ccall,cwrap,HEAPU8",
            "-sEXPORTED_FUNCTIONS=_main,_malloc,_free,_imrmf_canvas_on_worker_decoded,_imrmf_canvas_on_fast_decoded,_imrmf_bundle_add_asset,_imrmf_bundle_build,_imrmf_bundle_data,_imrmf_bundle_release,_imrmf_bundle_open,_imrmf_create_source_set",
        ],
        "//conditions:default": [],
    }),
    target_compatible_with = select({
        "//config:wasm": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = _APP_DEPS,
)

wasm_cc_binary(
    name = "editor_wasm",
    cc_target = ":editor_wasm_target",
)

# Desktop build of the same main.cpp. No server sync, the Yjs hooks are stubs.
cc_binary(
    name = "editor",
    srcs = ["main.cpp"],
    data = [
        "//ui:font_licenses",
        "//ui:font_mdi",
        "//ui:font_ttf",
    ],
    target_compatible_with = select({
        "//config:wasm": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = _APP_DEPS,
)
