load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

# y-sync protocol + the CRDT<->yaml mapping. Shared with the desktop client.
rust_library(
    name = "core",
    srcs = [
        "src/lib.rs",
        "src/sync.rs",
        "src/yaml_bridge.rs",
    ],
    crate_name = "imrmf_core",
    crate_root = "src/lib.rs",
    edition = "2021",
    deps = [
        "@crates//:anyhow",
        "@crates//:serde_yaml",
        "@crates//:tracing",
        "@crates//:yrs",
    ],
)

rust_test(
    name = "core_test",
    crate = ":core",
    edition = "2021",
)

_SERVER_SRCS = [
    "src/main.rs",
    "src/server.rs",
    "src/state.rs",
    "src/storage/mod.rs",
    "src/storage/local.rs",
    "src/storage/s3.rs",
    "src/validate.rs",
]

_SERVER_DEPS = [
    ":core",
    "@crates//:anyhow",
    "@crates//:aws-config",
    "@crates//:aws-credential-types",
    "@crates//:aws-sdk-s3",
    "@crates//:axum",
    "@crates//:bytes",
    "@crates//:clap",
    "@crates//:futures",
    "@crates//:futures-util",
    "@crates//:serde",
    "@crates//:serde_json",
    "@crates//:serde_yaml",
    "@crates//:tempfile",
    "@crates//:tokio",
    "@crates//:tokio-stream",
    "@crates//:tower-http",
    "@crates//:tracing",
    "@crates//:tracing-subscriber",
    "@crates//:yrs",
]

_SERVER_PROC_MACRO_DEPS = ["@crates//:async-trait"]

rust_binary(
    name = "imrmf_map_editor",
    srcs = _SERVER_SRCS,
    data = ["@rmf_building_map_tools//:building_map_generator_bin"] + select({
        "//config:no_ros2": [],
        "//conditions:default": ["@rmf_building_map_tools//:building_map_server_bin"],
    }),
    edition = "2021",
    proc_macro_deps = _SERVER_PROC_MACRO_DEPS,
    deps = _SERVER_DEPS,
)

rust_test(
    name = "server_test",
    srcs = _SERVER_SRCS,
    crate_root = "src/main.rs",
    edition = "2021",
    proc_macro_deps = _SERVER_PROC_MACRO_DEPS,
    deps = _SERVER_DEPS,
)
