load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

_GL_LINKOPTS = select({
    "@platforms//os:macos": ["-framework OpenGL"],
    "@platforms//os:linux": ["-lGL"],
    "//conditions:default": [],  # emscripten links GL itself
})

cc_library(
    name = "canvas",
    srcs = [
        "canvas.cpp",
        "overlays.cpp",
    ],
    hdrs = [
        "canvas.hpp",
        "gl.hpp",
        "overlays.hpp",
    ],
    linkopts = _GL_LINKOPTS,
    strip_include_prefix = "/",
    deps = [
        "//model",
        "//ui:icons",
        "//ui:theme",
        "//ui:viewport",
        "//ui:widgets",
        "@imgui_docking//:imgui",
    ],
)

cc_library(
    name = "http_texture_provider",
    srcs = ["http_texture_provider.cpp"] + select({
        "//config:wasm": [],
        "//conditions:default": ["stb_image.h"],
    }),
    hdrs = ["http_texture_provider.hpp"],
    linkopts = _GL_LINKOPTS,
    strip_include_prefix = "/",
    deps = [":canvas"] + select({
        "//config:wasm": [],
        "//conditions:default": ["@curl"],
    }),
)

cc_library(
    name = "stb_texture_provider",
    srcs = [
        "stb_image.h",
        "stb_texture_provider.cpp",
    ],
    hdrs = ["stb_texture_provider.hpp"],
    linkopts = _GL_LINKOPTS,
    deps = [":canvas"],
)
